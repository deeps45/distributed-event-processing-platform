# Docker Compose services get their own kafka:9092 / redis:6379 / postgres:5432
# via docker-compose.yml directly (not this file). This .env is for running
# things on the host against the dockerized stack - e.g. scripts/benchmark.py
# - which is why it points at the external listener/published ports instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC_EVENTS=events
KAFKA_TOPIC_DLQ=events.dlq
KAFKA_CONSUMER_GROUP=event-processors

REDIS_URL=redis://localhost:6379/0

POSTGRES_DSN=postgresql://events:events@localhost:5432/events

MAX_RETRIES=5
RETRY_BACKOFF_BASE_SECONDS=0.5
IDEMPOTENCY_TTL_SECONDS=86400

# Failure simulation, for demonstrating retry/DLQ behavior locally. 0.0 disables it.
SIMULATE_FAILURE_RATE=0.05

# Optional AWS integration - leave AWS_* unset / ENABLE_* false to run fully offline.
AWS_REGION=us-east-1
S3_ARCHIVE_BUCKET=
ENABLE_CLOUDWATCH_METRICS=false
